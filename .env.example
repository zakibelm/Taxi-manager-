# Serveur Taxi Manager — copier vers .env.local (jamais committé). Aucun secret avec le préfixe VITE_.
# n8n : URL de base des webhooks (se termine en général par /webhook), HTTPS obligatoire hors boucle locale.
N8N_URL=
# Valeur de l'identifiant Header Auth branché sur les webhooks TM (actuellement « DrivePilot application - webhook dédié »).
N8N_TOKEN=
# Secret dédié aux empreintes HMAC des IP et identifiants (32 octets hex). Repli sur N8N_TOKEN s'il est vide.
HMAC_SECRET=
# Facultatifs : en-tête et préfixe des workflows TM.
N8N_TOKEN_HEADER=X-DrivePilot-Token
N8N_PREFIX=taximanager-tm
# Courriels administrateurs (séparés par des virgules).
ADMIN_EMAILS=
# Chauffeurs autorisés : courriels ou domaines (@flotte.ca), séparés par des virgules. Vide = inscription ouverte.
# Retirer une adresse ferme ses sessions. Les courriels de ADMIN_EMAILS sont toujours autorisés.
ALLOWED_EMAILS=
# Adresse publique utilisée dans les liens des courriels (obligatoire en production).
PUBLIC_URL=
# n8n (défaut, SMTP via le workflow Comptes TM) ou log (lien écrit dans le journal, pour amorcer le premier compte).
MAIL_PROVIDER=n8n
# Types de service proposés (facultatif, séparés par des virgules).
SERVICE_TYPES=
# Assistant IA — passerelle OmniRoute (compatible OpenAI). Exemple Tailscale : http://100.x.y.z:20128/v1
LLM_BASE_URL=
LLM_API_KEY=
# Nom du combo OmniRoute composé de modèles gratuits uniquement (défaut : taxi-free).
LLM_MODEL=
# Repli sans OmniRoute : OpenRouter, modèles gratuits uniquement (openrouter/free ou :free).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
HOST=127.0.0.1
PORT=3012
# 1 derrière UN proxy de confiance (nginx, Traefik) : la dernière adresse de X-Forwarded-For fait foi.
TRUST_PROXY=0
NODE_ENV=development
