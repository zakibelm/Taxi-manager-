# Serveur Taxi Manager — copier vers .env.local (jamais committé). Aucun secret avec le préfixe VITE_.
# n8n : URL de base des webhooks (se termine en général par /webhook), HTTPS obligatoire hors boucle locale.
N8N_URL=
# Valeur de l'identifiant Header Auth branché sur les webhooks TM (actuellement « DrivePilot application - webhook dédié »).
N8N_TOKEN=
# Facultatifs : en-tête et préfixe des workflows TM.
N8N_TOKEN_HEADER=X-DrivePilot-Token
N8N_PREFIX=taximanager-tm
# Courriels administrateurs (séparés par des virgules).
ADMIN_EMAILS=
# Adresse publique utilisée dans les liens des courriels (obligatoire en production).
PUBLIC_URL=
# n8n (défaut, SMTP via le workflow Comptes TM) ou log (lien écrit dans le journal, pour amorcer le premier compte).
MAIL_PROVIDER=n8n
# Types de service proposés (facultatif, séparés par des virgules).
SERVICE_TYPES=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
HOST=127.0.0.1
PORT=3012
TRUST_PROXY=0
NODE_ENV=development
